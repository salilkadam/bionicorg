DATABASE_URL=postgres://bionic:bionic@localhost:5432/bionic
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=bionic-dev-secret
BIONIC_TOOL_ACTION_SIGNING_SECRET=bionic-dev-tool-action-signing-secret-change-me

# Optional Bionic ID Gmail OAuth broker. Enroll the instance first; keep both
# private keys in the deployment secret manager. HTTP base URLs must be loopback.
# BIONIC_ID_CONNECTOR_BASE_URL=http://localhost:3000
# BIONIC_ID_CONNECTOR_ENVIRONMENT=development
# BIONIC_ID_CONNECTOR_INSTANCE_ID=inst_example
# BIONIC_ID_CONNECTOR_SIGN_PRIVATE_KEY=
# BIONIC_ID_CONNECTOR_SEAL_PRIVATE_KEY=

# Process-wide protection for expensive full-tree workspace Git scans.
# BIONIC_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# BIONIC_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# BIONIC_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# BIONIC_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# HTTP adapters may call public HTTP(S) origins by default. Opt trusted private
# origins in explicitly; entries are exact origins (scheme, host, and port).
# BIONIC_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://hooks.internal.example:8080

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
