{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bionic.dev/schemas/prp/v1/fixture.schema.json",
  "title": "PRP scripted replay fixture",
  "type": "object",
  "required": [
    "schema",
    "fixtureVersion",
    "protocolVersion",
    "name",
    "description",
    "identity",
    "capabilities",
    "commands",
    "events",
    "result"
  ],
  "properties": {
    "schema": { "const": "bionic.prp.fixture.v1" },
    "fixtureVersion": { "const": 1 },
    "protocolVersion": { "enum": [1, 2] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "identity": { "$ref": "https://bionic.dev/schemas/prp/v1/identity.schema.json" },
    "capabilities": {
      "oneOf": [
        { "$ref": "https://bionic.dev/schemas/prp/v1/capabilities.schema.json" },
        { "$ref": "https://bionic.dev/schemas/prp/v2/capabilities.schema.json" }
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "https://bionic.dev/schemas/prp/v1/command.schema.json" },
          { "$ref": "https://bionic.dev/schemas/prp/v2/command.schema.json" }
        ]
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "https://bionic.dev/schemas/prp/v1/event.schema.json" },
          { "$ref": "https://bionic.dev/schemas/prp/v2/event.schema.json" }
        ]
      }
    },
    "requests": {
      "type": "array",
      "items": { "$ref": "https://bionic.dev/schemas/prp/v1/request.schema.json" }
    },
    "result": { "$ref": "https://bionic.dev/schemas/prp/v1/result.schema.json" }
  },
  "additionalProperties": true
}
